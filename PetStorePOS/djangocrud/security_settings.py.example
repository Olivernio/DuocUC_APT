"""
Configuraciones de Seguridad para Producción
Copiar este archivo y ajustar según necesidades
"""

import os
from pathlib import Path

# ============================================
# CONFIGURACIONES CRÍTICAS DE SEGURIDAD
# ============================================

# 1. SECRET_KEY desde variables de entorno
SECRET_KEY = os.environ.get('SECRET_KEY')
if not SECRET_KEY:
    raise ValueError("SECRET_KEY debe estar configurada en variables de entorno")

# 2. DEBUG deshabilitado en producción
DEBUG = os.environ.get('DEBUG', 'False') == 'True'

# 3. ALLOWED_HOSTS configurado
ALLOWED_HOSTS = os.environ.get('ALLOWED_HOSTS', '').split(',')
if not ALLOWED_HOSTS or ALLOWED_HOSTS == ['']:
    ALLOWED_HOSTS = ['localhost', '127.0.0.1']

# 4. Claves reCAPTCHA desde variables de entorno
RECAPTCHA_PUBLIC_KEY = os.environ.get('RECAPTCHA_PUBLIC_KEY', '')
RECAPTCHA_PRIVATE_KEY = os.environ.get('RECAPTCHA_PRIVATE_KEY', '')

# ============================================
# CONFIGURACIÓN HTTPS/SSL
# ============================================

# Forzar HTTPS (solo en producción con SSL)
SECURE_SSL_REDIRECT = os.environ.get('SECURE_SSL_REDIRECT', 'False') == 'True'

# Cookies seguras
SESSION_COOKIE_SECURE = not DEBUG  # True en producción
CSRF_COOKIE_SECURE = not DEBUG      # True en producción

# ============================================
# HEADERS DE SEGURIDAD
# ============================================

# Protección XSS
SECURE_BROWSER_XSS_FILTER = True
SECURE_CONTENT_TYPE_NOSNIFF = True

# Clickjacking
X_FRAME_OPTIONS = 'DENY'

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS = 31536000  # 1 año
SECURE_HSTS_INCLUDE_SUBDOMAINS = True
SECURE_HSTS_PRELOAD = True

# ============================================
# CONFIGURACIÓN DE SESIONES
# ============================================

SESSION_COOKIE_AGE = 3600  # 1 hora en segundos
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_SAMESITE = 'Lax'
SESSION_EXPIRE_AT_BROWSER_CLOSE = True

